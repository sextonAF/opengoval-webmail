// Copy to the repository root as wrangler.opengoval.multiuser.local.jsonc.
// Never reuse the single-user Worker's name or attach its shared D1 database.
{
  "name": "opengoval-webmail-multiuser",
  "main": "server/entries/opengoval-workers.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "mail.opengoval.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOXES", "class_name": "MailboxUser" },
      { "name": "LOGIN_LIMITER", "class_name": "LoginLimiter" }
    ]
  },
  "migrations": [
    { "tag": "opengoval-v1", "new_sqlite_classes": ["MailboxUser", "LoginLimiter"] }
  ]
}
